OPENAI_API_KEY=
OPENAI_API_KEY_BACKUP=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-6-luna
OPENAI_REVIEW_MODEL=gpt-6-luna
GITHUB_TOKEN=
# Optional. Fine-grained read-only public token used only by the Algolia issue sync.
# When unset, the sync falls back to GITHUB_TOKEN.
GITHUB_SYNC_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
FIRST_PASS_PROVIDER=openai
NEYSA_GEMMA_KEY=
NEYSA_GEMMA_URL=
NEYSA_GEMMA_MODEL=gemma-4-26-b-a4-b-it
NEYSA_QWEN_KEY=
NEYSA_QWEN_URL=
NEYSA_QWEN_MODEL=qwen3.6-27-b
SERPAPI_KEY=
# Algolia for Open Source. Leave blank to keep GitHub search.
# Application ID for the approved app is VD6Y3O5GB7. Set the same value on both app id vars.
# Never commit ALGOLIA_ADMIN_KEY or the search key.
ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_APP_ID=
ALGOLIA_ADMIN_KEY=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
ALGOLIA_INDEX_NAME=firstpr_issues
# NEXT_PUBLIC_ALGOLIA_INDEX_NAME=firstpr_issues
CRON_SECRET=
DEMO_REPO=nishal21/NekoDroid
DEMO_USERNAME=nishal21
DEMO_MODE=auto
# RECORD_DEMO=1  # with npm run dev, then: npx tsx scripts/record-demo.ts
# After deploy: GET /api/health → hasOpenAI / hasGitHub should be true when keys are set on Vercel.

# SEO (all optional)
# NEXT_PUBLIC_SITE_URL=https://firstpr.nishal.dev  # canonical origin for metadata, sitemap, OG, bot links (this is the default)
# GOOGLE_SITE_VERIFICATION=   # Search Console HTML-tag token, only the content value
# BING_SITE_VERIFICATION=     # Bing Webmaster msvalidate.01 content value
# Sentry (all optional). With no DSN, Sentry stays off.
# DSN: Sentry > Project Settings > Client Keys (DSN). Same value is fine for both.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Build-time only: source maps, releases, commit links. Organization token. Never commit it.
SENTRY_AUTH_TOKEN=
# SENTRY_ORG=nkcodex
# SENTRY_PROJECT=firstpr
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1